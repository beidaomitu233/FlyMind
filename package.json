{
  "name": "flymind-drawing-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc && vite build",
    "preview": "vite preview",
    "backend": "python -m uvicorn backend.main:app --reload --host 0.0.0.0 --port 8000",
    "test": "node --import tsx --test tests/drawing.test.ts",
    "test:legacy": "node tests/run-tests.mjs",
    "render": "tsx scripts/render-diagram.ts",
    "examples": "tsx scripts/build-examples.ts"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@vitejs/plugin-vue": "^5.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vue-tsc": "3.0.8"
  }
}
