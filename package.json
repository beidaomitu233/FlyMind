{
  "name": "flymind-drawing-studio",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "start": "node server/start.mjs --runtime",
    "mcp": "node server/start.mjs",
    "setup:codex": "node scripts/setup-codex.mjs",
    "build": "vue-tsc && tsc -p tsconfig.server.json && vite build",
    "preview": "vite preview",
    "backend": "python -m uvicorn backend.main:app --reload --host 0.0.0.0 --port 8000",
    "test": "node --import tsx --test tests/drawing.test.ts tests/runtime.test.ts",
    "test:legacy": "node tests/run-tests.mjs",
    "render": "tsx scripts/render-diagram.ts",
    "examples": "tsx scripts/build-examples.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "pinia": "^2.1.7",
    "sharp": "^0.35.5",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@vitejs/plugin-vue": "^6.0.8",
    "tsx": "^4.22.3",
    "typescript": "^5.3.0",
    "vite": "^7.3.7",
    "vue-tsc": "3.0.8"
  }
}
