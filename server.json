{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.beidaomitu233/flymind",
  "description": "Local AI diagrams with draw.io editing and native PNG/SVG exports.",
  "repository": {
    "url": "https://github.com/beidaomitu233/FlyMind",
    "source": "github"
  },
  "version": "1.0.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "flymind-drawing-studio",
      "version": "1.0.0",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
