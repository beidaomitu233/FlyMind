# Copy values into your service manager's private environment file, outside Git.
# Prepare a NEW isolated MySQL database; Flyway refuses a nonempty unmanaged database.
ADMIN_DB_JDBC_URL=jdbc:mysql://127.0.0.1:3306/flymind_control?useUnicode=true&characterEncoding=UTF-8&serverTimezone=UTC
ADMIN_DB_USER=
ADMIN_DB_PASSWORD=
ADMIN_REDIS_HOST=127.0.0.1
ADMIN_REDIS_PORT=6379
ADMIN_REDIS_DATABASE=0
ADMIN_REDIS_PASSWORD=
ADMIN_BIND_ADDRESS=127.0.0.1
ADMIN_PORT=18080
FLYMIND_APP_TENANT_ID=flymind-app
# Generate separate random values, at least 32 UTF-8 bytes each. No default credentials.
JWT_SECRET=
FLYMIND_GATEWAY_KEY=
FLYMIND_CLOUD_PUBLIC_ORIGIN=https://your-flymind-host.example
# First empty-database bootstrap only; remove all three after successful initialization.
# FLYMIND_BOOTSTRAP_ENABLED=true
# FLYMIND_BOOTSTRAP_PHONE=
# FLYMIND_BOOTSTRAP_PASSWORD=
