FLYMIND_CLOUD_PUBLIC_ORIGIN=https://draw.example.com
FLYMIND_CLOUD_CONTROL_PLANE_URL=http://127.0.0.1:18080
FLYMIND_CLOUD_DATA_DIR=/var/lib/flymind/production/diagrams
FLYMIND_CLOUD_BIND=127.0.0.1
FLYMIND_CLOUD_PORT=5192
FLYMIND_CLOUD_DRAIN_MS=60000
# Explicitly permits fixed same-machine HTTP hops, not public arbitrary HTTP hosts.
FLYMIND_CLOUD_DEV_LOOPBACK=1
FLYMIND_GATEWAY_KEY=REPLACE_WITH_PRIVATE_RANDOM_VALUE_AT_LEAST_32_BYTES
