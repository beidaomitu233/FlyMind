{
  "schemaVersion": 1,
  "id": "baseline-pbs-main",
  "title": "示例申请服务主线（存量结构）",
  "kind": "swimlane",
  "nodes": [
    {
      "id": "n01",
      "label": "订单入池：同步或手工登记",
      "kind": "start",
      "laneId": "r01",
      "phaseId": "p01"
    },
    {
      "id": "n02",
      "label": "指定项目统筹负责人",
      "kind": "task",
      "laneId": "r01",
      "phaseId": "p01",
      "description": "管理员必选项目统筹负责人；允许预配其他成员。"
    },
    {
      "id": "n03",
      "label": "指定或确认项目负责人",
      "kind": "task",
      "laneId": "r02",
      "phaseId": "p01",
      "description": "统筹仍需指定或确认项目负责人，不能被前一环节的预配替代。"
    },
    {
      "id": "n04",
      "label": "项目负责人决定是否接单",
      "kind": "decision",
      "laneId": "r03",
      "phaseId": "p01"
    },
    {
      "id": "p02",
      "label": "整理学生信息、目标与时限",
      "kind": "task",
      "laneId": "r03",
      "phaseId": "p02"
    },
    {
      "id": "n06",
      "label": "按院校目标规划已付款任务",
      "kind": "task",
      "laneId": "r03",
      "phaseId": "p02",
      "description": "优先复用已配成员，按已购买且已付款的服务安排任务；退回调整保留已交付成果。"
    },
    {
      "id": "n07",
      "label": "成员领取并执行文书、申请和追踪",
      "kind": "task",
      "laneId": "r04",
      "phaseId": "p03",
      "description": "各目标独立推进；文书可按份交付，其他任务继续；成员可在执行中退回。"
    },
    {
      "id": "n08",
      "label": "统筹检查时限和目标进展",
      "kind": "task",
      "laneId": "r02",
      "phaseId": "p03",
      "description": "统筹可调整人员并持续检查进展与异常。"
    },
    {
      "id": "n09",
      "label": "处理任务退回并调整安排",
      "kind": "task",
      "laneId": "r03",
      "phaseId": "p03"
    },
    {
      "id": "n10",
      "label": "负责人核验单个目标完成",
      "kind": "task",
      "laneId": "r03",
      "phaseId": "p03",
      "description": "单个目标核验后，当前订单的所有目标与成果齐备才进入结项汇总。"
    },
    {
      "id": "n11",
      "label": "向交易平台交付文书",
      "kind": "task",
      "laneId": "r03",
      "phaseId": "p03",
      "description": "平台订单的文书支持分次交付，不等待全部目标。"
    },
    {
      "id": "n12",
      "label": "统筹核验结项材料",
      "kind": "decision",
      "laneId": "r02",
      "phaseId": "p04",
      "description": "核验目标均已完成、成果与报告齐全。"
    },
    {
      "id": "p04",
      "label": "统筹确认报告并结项归档",
      "kind": "task",
      "laneId": "r02",
      "phaseId": "p04",
      "description": "单笔订单分别结项，手工登记订单直接结束；平台订单的报告由项目负责人交付。"
    },
    {
      "id": "n14",
      "label": "将结项报告交付交易平台",
      "kind": "task",
      "laneId": "r02",
      "phaseId": "p05"
    },
    {
      "id": "n15",
      "label": "服务完成",
      "kind": "end",
      "laneId": "r02",
      "phaseId": "p05"
    },
    {
      "id": "n16",
      "label": "管理员可选预配成员",
      "kind": "task",
      "laneId": "r01",
      "phaseId": "p01",
      "description": "管理员可预配其他成员；统筹仍负有确认项目负责人责任。"
    },
    {
      "id": "n17",
      "label": "统筹可选预配成员",
      "kind": "task",
      "laneId": "r02",
      "phaseId": "p01"
    },
    {
      "id": "n18",
      "label": "统筹直接调整交付成员",
      "kind": "task",
      "laneId": "r02",
      "phaseId": "p03",
      "description": "统筹调整后由执行成员重新领取任务。"
    },
    {
      "id": "n19",
      "label": "向交易平台交付申请任务",
      "kind": "task",
      "description": "来源记录沿用了文书分次交付说明，与申请任务标题不一致；此矛盾保留待确认。",
      "laneId": "r03",
      "phaseId": "p03"
    },
    {
      "id": "n20",
      "label": "核验未通过说明",
      "kind": "note",
      "laneId": "r03",
      "phaseId": "p04"
    },
    {
      "id": "n21",
      "label": "接单退回说明",
      "kind": "note",
      "laneId": "r01",
      "phaseId": "p01"
    },
    {
      "id": "n22",
      "label": "手工登记订单说明",
      "kind": "note",
      "laneId": "r03",
      "phaseId": "p05"
    },
    {
      "id": "n23",
      "label": "平台同步订单说明",
      "kind": "task",
      "laneId": "r02",
      "phaseId": "p05"
    }
  ],
